<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never let credentials / cache leave the device through backup. -->
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
